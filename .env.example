# Environment Configuration
VITE_ENVIRONMENT=development

# Counter API (visitor counter, counterapi.dev)
# VITE_COUNTER_WORKSPACE=your_workspace_name
# VITE_API_BASE_URL=https://api.counterapi.dev/v2
# VITE_COUNTER_CACHE_TTL=300000

# Optional: Google Analytics
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Note:
# - Counter API resets daily (per-page-load counts, not a cumulative total)
# Environment-specific files: .env.development, .env.staging, .env.production